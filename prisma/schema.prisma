generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  publisher      String?
  description    String?
  imageUrl       String
  bannerUrl      String?
  currencyName   String
  uidLabel       String        @default("Player ID")
  uidExample     String?
  requiresServer Boolean       @default(false)
  servers        String        @default("[]")
  featured       Boolean       @default(false)
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  // "DIRECT" = admin can hand over a purchased Account for this game straight
  // away (no chat needed first); "MANUAL" = buyer is pointed to Telegram to
  // arrange handoff after paying. Only used by the Accounts marketplace —
  // Top-up / Products never read this field.
  deliveryMode   String        @default("DIRECT")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  GameAccount    GameAccount[]
  GameItem       GameItem[]
  orders         Order[]
  products       Product[]
}

model User {
  id           String         @id @default(cuid())
  email        String?        @unique
  phone        String?        @unique
  passwordHash String
  name         String?
  points       Int            @default(0)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  orders       Order[]
  gameItemOrders    GameItemOrder[]
  gameAccountOrders GameAccountOrder[]
  pointsLedger PointsLedger[]
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  type      String
  points    Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
}

model Product {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  amount    Int
  bonus     Int      @default(0)
  priceUsd  Float
  priceKhr  Float?
  badge     String?
  imageUrl  String?
  active    Boolean  @default(true)
  stock     Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  orderItems OrderItem[]
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, active])
}

// A single line inside a multi-package cart order. Only used for orders where
// the shopper picked more than one package in one checkout (currently: Roblox
// only — see TopUpForm's cart mode). Regular single-package orders across all
// other games never create these rows and keep using `Order.productId`
// directly, so nothing about their behavior changes.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  name         String
  amount       Int
  bonus        Int      @default(0)
  quantity     Int      @default(1)
  unitPriceUsd Float
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Order {
  id                String     @id @default(cuid())
  orderNumber       String     @unique
  gameId            String
  productId         String
  playerUid         String
  serverId          String?
  playerNickname    String?
  customerEmail     String?
  customerPhone     String?
  amountUsd         Float
  amountKhr         Float?
  currency          String     @default("USD")
  paymentMethod     String
  paymentRef        String?
  paymentUrl        String?
  qrString          String?
  paymentExpiresAt  DateTime?
  status            String     @default("PENDING")
  deliveryNote      String?
  failureReason     String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  paidAt            DateTime?
  deliveredAt       DateTime?
  promoCodeId       String?
  discountUsd       Float      @default(0)
  pointsAwarded     Boolean    @default(false)
  pointsDiscountUsd Float      @default(0)
  pointsEarned      Int        @default(0)
  pointsRedeemed    Int        @default(0)
  stockDecremented  Boolean    @default(false)
  userId            String?
  game              Game       @relation(fields: [gameId], references: [id])
  product           Product    @relation(fields: [productId], references: [id])
  promoCode         PromoCode? @relation(fields: [promoCodeId], references: [id])
  user              User?      @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([userId])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Float
  minOrderUsd   Float     @default(0)
  maxUses       Int       @default(0)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("ADMIN")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model Settings {
  id                 Int      @id @default(1)
  siteName           String   @default("RITHTOPUP")
  exchangeRate       Float    @default(4100)
  supportTelegram    String?  @default("@rithtopup")
  supportEmail       String?  @default("support@rithtopup.com")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  announcement       String?
  announcementTone   String?  @default("info")
  telegramBotToken   String?
  telegramChatId     String?
  updatedAt          DateTime @updatedAt
  minRedeemPoints    Int      @default(100)
  pointsPerUsd       Float    @default(1)
  pointsRedeemRate   Float    @default(100)
}

model RobuxStock {
  id         Int      @id @default(1)
  totalRobux Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  ctaLabel  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverUrl    String?
  tag         String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model BlockedIdentity {
  id        String   @id @default(cuid())
  type      String
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model GameAccount {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  gameId      String?
  // Optional label from the admin's own list (GameAccountCategory) — lets
  // an account be grouped/labelled without needing a full entry on the
  // Top-up `Game` list. Independent of gameId; an account can set either,
  // both, or neither (falls back to "General").
  categoryId  String?
  title       String
  rank        String?
  description String?
  imageUrl    String?
  priceUsd    Float
  priceKhr    Float?
  sold        Boolean  @default(false)
  // "UNIQUE" = one-of-a-kind login handover; only ever one buyer, tracked by
  // the `sold` flag above (unchanged behaviour). "MULTI" = stackable stock —
  // buyers pick a quantity at checkout, tracked by the `stock` count below
  // instead of `sold`.
  stockMode   String   @default("UNIQUE")
  // Remaining units available. Only meaningful when stockMode = "MULTI";
  // UNIQUE accounts ignore this and rely on `sold` instead.
  stock       Int      @default(1)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  // "DIRECT" = admin can hand over this account's login straight away (no
  // chat needed first); "MANUAL" = buyer is pointed to Telegram to arrange
  // handoff after paying. Set per account (like GameItem.deliveryMode),
  // not read from the linked Game anymore — see backfill script in
  // prisma/scripts/backfill-account-deliverymode.ts for the one-off copy
  // from each account's previous Game.deliveryMode onto this column.
  deliveryMode String  @default("MANUAL")
  // Admin-only login handover (username/password/notes), set when this
  // account's deliveryMode = "DIRECT". Never returned by any public
  // API until the buyer's order is PAID/DELIVERED.
  credentials String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  Game        Game?    @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Category    GameAccountCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orderItems  GameAccountOrderItem[]

  @@index([gameId])
  @@index([categoryId])
}

// Admin's own labels for the Accounts marketplace — intentionally separate
// from `Game` (which powers Top-up and requires a lot of fields: imageUrl,
// currencyName, a unique slug, etc. that don't make sense for "just a
// label"). Purely a grouping/display concept, same relationship GameItem
// has with GameItemCategory. Delivery mode lives on GameAccount itself.
model GameAccountCategory {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  slug        String   @unique
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  GameAccount GameAccount[]
}

model GameItem {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  gameId      String?
  categoryId  String?
  name        String
  description String?
  imageUrl    String?
  priceUsd    Float
  priceKhr    Float?
  badge       String?
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  // "DIRECT" = admin delivers this item straight into the buyer's game
  // account using the Username they typed at checkout; "MANUAL" = buyer is
  // pointed to Telegram to arrange face-to-face handoff after paying. Set
  // per item (not per category) since two items in the same category can
  // need different handling.
  deliveryMode String           @default("DIRECT")
  createdAt   DateTime          @default(now()) @db.Timestamp(6)
  updatedAt   DateTime          @default(now()) @db.Timestamp(6)
  Game        Game?             @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Category    GameItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orderItems  GameItemOrderItem[]

  @@index([gameId])
  @@index([categoryId])
}

// Categories for the Game Items storefront. Intentionally separate from
// `Game` (which powers Top-up) so the two features never share taxonomy.
// Purely a grouping/display concept — delivery mode lives on GameItem now.
model GameItemCategory {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  slug         String     @unique
  imageUrl     String?
  sortOrder    Int        @default(0)
  // DEPRECATED — no longer read or written by the app. Kept here (instead
  // of dropped in the same `db push` that adds GameItem.deliveryMode) so
  // prisma/scripts/backfill-item-deliverymode.ts has a safe window to copy
  // each existing value onto its items before the column is ever dropped.
  // Safe to remove this field (and run `db push` once more) any time after
  // you've run that backfill script.
  deliveryMode String     @default("DIRECT")
  createdAt    DateTime   @default(now()) @db.Timestamp(6)
  updatedAt    DateTime   @default(now()) @db.Timestamp(6)
  GameItem     GameItem[]
}

// ─────────────────────────────────────────────────────────────────────────
// Game Items marketplace orders. Deliberately its own table, independent of
// the Top-up `Order`/`Product` model — a shopper can select several GameItem
// cards (optionally across different categories) and check out once; every
// selected line becomes a GameItemOrderItem under one GameItemOrder. Uses
// the same KHPay gateway as Top-up and Accounts via lib/payment.ts.
// ─────────────────────────────────────────────────────────────────────────
model GameItemOrder {
  id               String    @id @default(cuid())
  orderNumber      String    @unique
  buyerUsername    String
  // Optional Telegram/phone/email — no longer collected at checkout for
  // Game Items (a MANUAL order sends the buyer to admin's Telegram, with
  // order details pre-filled, right after payment). Left here in case it's
  // ever set some other way.
  customerContact  String?
  amountUsd        Float
  amountKhr        Float?
  currency         String    @default("USD")
  paymentMethod    String
  paymentRef       String?
  paymentUrl       String?
  qrString         String?
  paymentExpiresAt DateTime?
  // Snapshot of resolveDeliveryMode() across the order's line items at
  // checkout time, so it can't change retroactively if admin edits an
  // item later. "DIRECT" only when every line item is DIRECT.
  deliveryMode     String
  status           String    @default("PENDING")
  deliveryNote     String?
  failureReason    String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  paidAt           DateTime?
  deliveredAt      DateTime?
  // Set when the buyer was signed in at checkout, so their order shows up
  // in the account History page. Null for guest checkouts — guest orders
  // stay lookup-only via the order number.
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  items            GameItemOrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model GameItemOrderItem {
  id           String   @id @default(cuid())
  orderId      String
  gameItemId   String
  name         String
  quantity     Int      @default(1)
  unitPriceUsd Float
  createdAt    DateTime @default(now())
  order        GameItemOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gameItem     GameItem      @relation(fields: [gameItemId], references: [id])

  @@index([orderId])
  @@index([gameItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// Accounts marketplace orders. Same pattern as GameItemOrder above, kept
// completely separate — its own table, never joined against GameItemOrder
// or the Top-up Order model, even though the storefront UI is designed to
// look identical.
// ─────────────────────────────────────────────────────────────────────────
model GameAccountOrder {
  id               String    @id @default(cuid())
  orderNumber      String    @unique
  customerContact  String?
  amountUsd        Float
  amountKhr        Float?
  currency         String    @default("USD")
  paymentMethod    String
  paymentRef       String?
  paymentUrl       String?
  qrString         String?
  paymentExpiresAt DateTime?
  // Snapshot of resolveDeliveryMode() across the order's accounts' Game at
  // checkout time. "DIRECT" only when every account's game is DIRECT.
  deliveryMode     String
  status           String    @default("PENDING")
  deliveryNote     String?
  failureReason    String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  paidAt           DateTime?
  deliveredAt      DateTime?
  // Set when the buyer was signed in at checkout, so their order shows up
  // in the account History page. Null for guest checkouts — guest orders
  // stay lookup-only via the order number.
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  items            GameAccountOrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model GameAccountOrderItem {
  id            String   @id @default(cuid())
  orderId       String
  gameAccountId String
  title         String
  quantity      Int      @default(1)
  unitPriceUsd  Float
  createdAt     DateTime @default(now())
  order         GameAccountOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gameAccount   GameAccount      @relation(fields: [gameAccountId], references: [id])

  @@index([orderId])
  @@index([gameAccountId])
}
