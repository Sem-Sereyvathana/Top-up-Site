generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (port 6543, via PgBouncer) can't run schema
  // changes reliably, so `prisma db push`/migrations use this direct one
  // (port 5432) instead. Everyday app queries still use DATABASE_URL above.
  directUrl = env("DIRECT_URL")
}

model Game {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  // DEPRECATED — replaced by groupId/Group below. Kept here only so
  // prisma/scripts/backfill-game-groups.ts has a safe window to copy each
  // existing value into a GameGroup before this column is ever dropped.
  // Safe to remove (and run `db push` once more) any time after that
  // backfill has run.
  groupName      String?
  // Optional: games sharing the same Group (e.g. every Mobile Legends server)
  // appear under ONE filter tab on the home page while keeping their own
  // card/page. Created once on the Games admin page ("Groups" manager),
  // same pattern as GameItemCategory for the Game Items storefront.
  groupId        String?
  Group          GameGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  publisher      String?
  description    String?
  imageUrl       String
  bannerUrl      String?
  currencyName   String
  uidLabel       String        @default("Player ID")
  uidExample     String?
  featured       Boolean       @default(false)
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  // "DIRECT" = admin can hand over a purchased Account for this game straight
  // away (no chat needed first); "MANUAL" = buyer is pointed to Telegram to
  // arrange handoff after paying. Only used by the Accounts marketplace —
  // Top-up / Products never read this field.
  deliveryMode   String        @default("DIRECT")
  // FazerCards category id for this game. When set, paid orders for this
  // game are topped up automatically through the supplier API.
  supplierSlug   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  GameAccount    GameAccount[]
  GameItem       GameItem[]
  orders         Order[]
  products       Product[]

  @@index([groupId])
}

// Reusable groups for the Top-up "Games" list — create the group (name +
// banner) once here, then pick it from a dropdown when creating/editing a
// Game card, instead of retyping a group name each time. Mirrors
// GameItemCategory, but intentionally its own table so Top-up and Game
// Items never share taxonomy.
model GameGroup {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  slug      String   @unique
  imageUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  Game      Game[]
}

model User {
  id                 String              @id @default(cuid())
  email              String?             @unique
  phone              String?             @unique
  passwordHash       String?
  telegramId         String?             @unique
  telegramUsername   String?
  googleId           String?             @unique
  avatarUrl          String?
  name               String?
  points             Int                 @default(0)
  active             Boolean             @default(true)
  // Resellers see (and are charged) Product.resellerPriceUsd instead of the
  // normal price everywhere in the Top-up storefront. Promoted/demoted from
  // the admin Users page; every change is written to the audit log.
  isReseller         Boolean             @default(false)
  // Wallet balance in INTEGER CENTS (never float — money math on floats
  // corrupts). Every change goes through WalletTransaction so the balance
  // always equals the ledger sum (see lib/wallet.ts).
  walletCents        Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLoginAt        DateTime?
  orders             Order[]
  gameItemOrders     GameItemOrder[]
  gameAccountOrders  GameAccountOrder[]
  pointsLedger       PointsLedger[]
  walletTransactions WalletTransaction[]
  walletTopUps       WalletTopUp[]
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  type      String
  points    Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
}

// One wallet ledger entry per balance change. User.walletCents must always
// equal the sum of amountCents over this table for that user — lib/wallet.ts
// enforces that invariant by writing balance + ledger row in one transaction.
// amountCents is signed: positive credits (topup/refund/admin_adjust credit),
// negative debits (purchase/admin_adjust deduction).
model WalletTransaction {
  id                String   @id @default(cuid())
  userId            String
  // "TOPUP" | "PURCHASE" | "REFUND" | "ADMIN_ADJUST"
  type              String
  amountCents       Int
  balanceAfterCents Int
  // Top-up Order id (PURCHASE), WalletTopUp id (TOPUP), or null.
  relatedOrderId    String?
  note              String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([relatedOrderId])
}

// A wallet top-up initiated by the user: one KHPay QR per top-up. Credited
// to the wallet exactly once by the payment webhook — idempotent via the
// status flip below (same atomic-claim pattern as Order stock/points).
model WalletTopUp {
  id               String    @id @default(cuid())
  // WT-prefixed order number, shared namespace with GI-/AC- (lib/utils).
  orderNumber      String    @unique
  userId           String
  amountCents      Int
  status           String    @default("PENDING")
  paymentMethod    String    @default("KHPAY")
  paymentRef       String?
  paymentUrl       String?
  qrString         String?
  paymentExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  paidAt           DateTime?
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// Outbox for the public proof-channel receipts. Written when an order is
// paid; a background sweep retries PENDING/FAILED rows so a Telegram outage
// never blocks or loses a receipt. Duplicate delivery is preferred over
// lost receipts, so retries continue until Telegram confirms.
model ReceiptLog {
  id          String    @id @default(cuid())
  // Top-up "topup:ORDER_ID" · items "gi:ORDER_ID" · accounts "ac:ORDER_ID"
  dedupeKey   String    @unique
  orderNumber String
  channel     String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

model Product {
  id               String      @id @default(cuid())
  gameId           String
  name             String
  amount           Int
  bonus            Int         @default(0)
  priceUsd         Float
  priceKhr         Float?
  // Reseller price for this exact package. Null = resellers pay priceUsd
  // too (fall back). For Robux Send packages the admin UI derives this from
  // a per-100-Robux rate (amount/100 × rate) but the stored value is always
  // the full package price — the server never does per-100 math at checkout.
  resellerPriceUsd Float?
  // What ONE unit of this package costs the operator. Supplier-linked
  // products get this snapshotted from FazerCards at dispatch; own-stock
  // products (Quick Login, Robux Send) use the admin-set value here.
  // Snapshot onto Order.costUsd at purchase so later edits don't rewrite
  // past profit.
  costUsd          Float?
  badge            String?
  imageUrl         String?
  active           Boolean     @default(true)
  stock            Int?
  // FazerCards offer id for this package (e.g. "234_23 + 78_8" for a bundle).
  supplierOfferId  String?
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orders           Order[]
  orderItems       OrderItem[]
  promoCodes       PromoCode[]
  game             Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, active])
}

// A single line inside a multi-package cart order. Only used for orders where
// the shopper picked more than one package in one checkout (currently: Roblox
// only — see TopUpForm's cart mode). Regular single-package orders across all
// other games never create these rows and keep using `Order.productId`
// directly, so nothing about their behavior changes.
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  name         String
  amount       Int
  bonus        Int      @default(0)
  quantity     Int      @default(1)
  unitPriceUsd Float
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  gameId              String
  productId           String
  playerUid           String
  serverId            String?
  playerNickname      String?
  customerEmail       String?
  customerPhone       String?
  amountUsd           Float
  amountKhr           Float?
  currency            String      @default("USD")
  paymentMethod       String
  paymentRef          String?
  paymentUrl          String?
  qrString            String?
  paymentExpiresAt    DateTime?
  status              String      @default("PENDING")
  deliveryNote        String?
  failureReason       String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  paidAt              DateTime?
  deliveredAt         DateTime?
  promoCodeId         String?
  discountUsd         Float       @default(0)
  pointsAwarded       Boolean     @default(false)
  pointsDiscountUsd   Float       @default(0)
  pointsEarned        Int         @default(0)
  pointsRedeemed      Int         @default(0)
  stockDecremented    Boolean     @default(false)
  supplierOrderNumber String?
  userId              String?
  // ── Reseller + cost snapshots (features: reseller pricing, profit) ──
  // What the package(s) would have cost a normal customer at purchase time.
  // Null on old orders. For reseller orders amountUsd < normalPriceUsd;
  // receipts always show normalPriceUsd.
  normalPriceUsd      Float?
  // True when the buyer was a reseller at checkout and paid reseller prices.
  isResellerOrder     Boolean     @default(false)
  // What this order cost the operator, snapshotted at purchase/dispatch.
  // Supplier orders: real FazerCards cost (fallback estimate, flagged).
  // Own stock: Product.costUsd at purchase time. Null = unknown (old order
  // or no cost set) — profit views treat it as "estimated" using current cost.
  costUsd             Float?
  costEstimated       Boolean     @default(false)
  game                Game        @relation(fields: [gameId], references: [id])
  product             Product     @relation(fields: [productId], references: [id])
  promoCode           PromoCode?  @relation(fields: [promoCodeId], references: [id])
  user                User?       @relation(fields: [userId], references: [id])
  items               OrderItem[]
  // Set when this order was paid as part of a combined multi-store
  // checkout (see PaymentGroup). Null for the normal single-store flow.
  paymentGroupId      String?

  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([userId])
  @@index([paymentGroupId])
}

model PromoCode {
  id                  String    @id @default(cuid())
  code                String    @unique
  discountType        String
  discountValue       Float
  minOrderUsd         Float     @default(0)
  maxUses             Int       @default(0)
  usedCount           Int       @default(0)
  expiresAt           DateTime?
  active              Boolean   @default(true)
  // When set, this coupon only applies to orders containing this exact
  // package. Null = works on any product, any game.
  applicableProductId String?
  applicableProduct   Product?  @relation(fields: [applicableProductId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  orders              Order[]
}

// Backs lib/rateLimit.ts. A row per (key, window-start) — atomic increment
// via upsert, so it works correctly even when the app is running as many
// separate serverless instances at once (which is why the old in-memory
// Map version didn't actually work in production on Vercel: each instance
// had its own counter, so the "10 attempts" limit was really "10 attempts
// per instance", not per IP overall).
model RateLimitBucket {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime

  @@index([windowStart])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("ADMIN")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // Failed-attempt lockout (per account, keyed by email — see lib/auth.ts).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // TOTP app authentication (Google Authenticator / Authy / etc). `totpSecret`
  // is only set once enrollment is completed; `totpEnabled` gates whether
  // login actually requires a code, so scanning the QR doesn't lock anyone
  // out mid-setup. `totpBackupCodes` are bcrypt-hashed single-use recovery
  // codes shown once at enrollment, for when the admin loses their device.
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([])
}

model Settings {
  id                         Int      @id @default(1)
  siteName                   String   @default("SharuStore")
  logoUrl                    String?
  exchangeRate               Float    @default(4100)
  supportTelegram            String?  @default("@sharustore")
  supportChannel             String?
  supportEmail               String?
  maintenanceMode            Boolean  @default(false)
  maintenanceMessage         String?
  announcement               String?
  announcementTone           String?  @default("info")
  telegramBotToken           String?
  telegramChatId             String?
  updatedAt                  DateTime @updatedAt
  minRedeemPoints            Int      @default(100)
  pointsPerUsd               Float    @default(1)
  pointsRedeemRate           Float    @default(100)
  // Public proof-channel receipts (feature: Telegram receipt webhook).
  // Uses the SAME bot token as operator notifications; only the destination
  // chat differs. Empty = receipts disabled.
  receiptTelegramChatId      String?
  // "How to redeem your code" video shown in a popup from the gift-card
  // order page (Admin -> Settings). A direct video URL (mp4/webm) or an embed
  // URL; empty = the button falls back to a short written hint.
  redeemVideoUrl             String?
  // Per-100-Robux rates the admin sets for Robux Send packages. Stored as
  // Settings-level defaults (normal + reseller + cost) that the Products
  // admin page can apply to every Robux Send package in one click; the
  // authoritative price remains per-Product (priceUsd / resellerPriceUsd /
  // costUsd).
  robuxSendPer100Usd         Float?
  robuxSendPer100ResellerUsd Float?
  robuxSendPer100CostUsd     Float?
  // ── Reseller rate config (pricing page) ────────────────────────────────
  // Robux Send: reseller $/100R and my cost $/100R (0.01–2 / 0.01–5).
  // Quick Log-In: reseller multiplier on face value (0.01–2) and my cost in
  // CENTS per $1 of face value (5–200). Normal prices are NEVER derived
  // from these — they stay the per-package table set on the Products page.
  resellerRobuxSendRate      Float?
  costRobuxSendRate          Float?
  resellerQuickLoginRate     Float?
  costQuickLoginRate         Float?
}

// One row per admin "clear revenue" action. Orders are NEVER deleted — this
// marker just tells the Revenue page which completed orders to EXCLUDE from
// its summaries (everything completed before `from` was "cleared" visually).
// Audit-safe: the orders, their payments, and wallet ledger stay untouched.
model RevenueReset {
  id         Int      @id @default(autoincrement())
  // UTC instant of the reset action itself.
  createdAt  DateTime @default(now())
  // Orders completed BEFORE this instant (UTC+7 day boundary semantics in
  // lib/revenue.ts) are excluded from Revenue summaries from now on.
  cutoff     DateTime
  // Which period the admin asked to clear, for the audit trail only.
  period     String
  adminEmail String?
}

model RobuxStock {
  id         Int      @id @default(1)
  totalRobux Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  ctaLabel  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverUrl    String?
  tag         String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model BlockedIdentity {
  id        String   @id @default(cuid())
  type      String
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model GameAccount {
  id           String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  gameId       String?
  // Optional label from the admin's own list (GameAccountCategory) — lets
  // an account be grouped/labelled without needing a full entry on the
  // Top-up `Game` list. Independent of gameId; an account can set either,
  // both, or neither (falls back to "General").
  categoryId   String?
  title        String
  rank         String?
  description  String?
  imageUrl     String?
  priceUsd     Float
  priceKhr     Float?
  sold         Boolean                @default(false)
  // Set only when an admin deletes an account that already has order
  // history (can't hard-delete without breaking past orders' FK — see
  // DELETE handler in app/api/admin/accounts/[id]/route.js). Archived
  // accounts are hidden from every admin list; their order-history rows
  // still work fine since those store their own title/price snapshot and
  // only need this row to keep existing, not to be visible anywhere.
  archived     Boolean                @default(false)
  // "UNIQUE" = one-of-a-kind login handover; only ever one buyer, tracked by
  // the `sold` flag above (unchanged behaviour). "MULTI" = stackable stock —
  // buyers pick a quantity at checkout, tracked by the `stock` count below
  // instead of `sold`.
  stockMode    String                 @default("UNIQUE")
  // Remaining units available. Only meaningful when stockMode = "MULTI";
  // UNIQUE accounts ignore this and rely on `sold` instead.
  stock        Int                    @default(1)
  active       Boolean                @default(true)
  sortOrder    Int                    @default(0)
  // "DIRECT" = admin can hand over this account's login straight away (no
  // chat needed first); "MANUAL" = buyer is pointed to Telegram to arrange
  // handoff after paying. Set per account (like GameItem.deliveryMode),
  // not read from the linked Game anymore — see backfill script in
  // prisma/scripts/backfill-account-deliverymode.ts for the one-off copy
  // from each account's previous Game.deliveryMode onto this column.
  deliveryMode String                 @default("MANUAL")
  // What this account costs the operator (profit dashboard). Null = unknown.
  costUsd      Float?
  // Admin-only login handover (username/password/notes), set when this
  // account's deliveryMode = "DIRECT". Never returned by any public
  // API until the buyer's order is PAID/DELIVERED.
  credentials  String?
  createdAt    DateTime               @default(now()) @db.Timestamp(6)
  updatedAt    DateTime               @default(now()) @db.Timestamp(6)
  Game         Game?                  @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Category     GameAccountCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orderItems   GameAccountOrderItem[]
  stockItems   GameAccountStockItem[]

  @@index([gameId])
  @@index([categoryId])
}

// Admin's own labels for the Accounts marketplace — intentionally separate
// from `Game` (which powers Top-up and requires a lot of fields: imageUrl,
// currencyName, a unique slug, etc. that don't make sense for "just a
// label"). Purely a grouping/display concept, same relationship GameItem
// has with GameItemCategory. Delivery mode lives on GameAccount itself.
// One row = one real login for a "Multiple stock" + Direct-delivery
// GameAccount. Replaces the old approach of sharing a single
// GameAccount.credentials string across every unit of stock (which meant
// every buyer of a multi-stock listing received the exact same login).
// `stock` on GameAccount is kept as a live cache of the AVAILABLE count
// here so every existing storefront/reservation check that reads
// GameAccount.stock keeps working unchanged.
model GameAccountStockItem {
  id            String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  gameAccountId String
  username      String
  password      String
  notes         String?
  // "AVAILABLE" = unsold, waiting to be handed to a buyer. "ASSIGNED" =
  // handed to a specific paid order line (orderItemId set) and never
  // reused.
  status        String                @default("AVAILABLE")
  orderItemId   String?
  assignedAt    DateTime?
  createdAt     DateTime              @default(now()) @db.Timestamp(6)
  gameAccount   GameAccount           @relation(fields: [gameAccountId], references: [id], onDelete: Cascade)
  orderItem     GameAccountOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([gameAccountId, status])
  @@index([orderItemId])
}

model GameAccountCategory {
  id          String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  slug        String        @unique
  imageUrl    String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamp(6)
  updatedAt   DateTime      @default(now()) @db.Timestamp(6)
  GameAccount GameAccount[]
}

model GameItem {
  id           String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  gameId       String?
  categoryId   String?
  name         String
  description  String?
  imageUrl     String?
  priceUsd     Float
  priceKhr     Float?
  badge        String?
  active       Boolean             @default(true)
  // Manually toggled by admin when this item is out of stock. Unlike
  // `active` (which fully removes the item from the storefront — used when
  // admin wants to pull a listing that isn't selling well), `soldOut` keeps
  // the card visible but greyed out with a "Sold Out" badge and disables
  // the Add-to-cart action. See app/game-items/page.tsx / ShopCartBrowser.
  soldOut      Boolean             @default(false)
  sortOrder    Int                 @default(0)
  // "DIRECT" = admin delivers this item straight into the buyer's game
  // account using the Username they typed at checkout; "MANUAL" = buyer is
  // pointed to Telegram to arrange face-to-face handoff after paying. Set
  // per item (not per category) since two items in the same category can
  // need different handling.
  deliveryMode String              @default("DIRECT")
  // What one unit costs the operator (profit dashboard). Null = unknown.
  costUsd      Float?
  createdAt    DateTime            @default(now()) @db.Timestamp(6)
  updatedAt    DateTime            @default(now()) @db.Timestamp(6)
  Game         Game?               @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Category     GameItemCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orderItems   GameItemOrderItem[]

  @@index([gameId])
  @@index([categoryId])
}

// Categories for the Game Items storefront. Intentionally separate from
// `Game` (which powers Top-up) so the two features never share taxonomy.
// Purely a grouping/display concept — delivery mode lives on GameItem now.
model GameItemCategory {
  id           String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  slug         String     @unique
  imageUrl     String?
  sortOrder    Int        @default(0)
  // DEPRECATED — no longer read or written by the app. Kept here (instead
  // of dropped in the same `db push` that adds GameItem.deliveryMode) so
  // prisma/scripts/backfill-item-deliverymode.ts has a safe window to copy
  // each existing value onto its items before the column is ever dropped.
  // Safe to remove this field (and run `db push` once more) any time after
  // you've run that backfill script.
  deliveryMode String     @default("DIRECT")
  createdAt    DateTime   @default(now()) @db.Timestamp(6)
  updatedAt    DateTime   @default(now()) @db.Timestamp(6)
  GameItem     GameItem[]
}

// ─────────────────────────────────────────────────────────────────────────
// Combined multi-store checkout. One PaymentGroup = one payment that covers
// a Top-up order, a Game Items order and/or an Accounts order bought
// together. Each child order keeps its own row and its own fulfilment
// logic; the group is what the buyer actually pays, and the single receipt
// is built from all three.
//
// orderNumber uses a "GRP-" prefix so the payment webhook / simulate route
// can tell it apart from RT-/GI-/AC- numbers.
// ─────────────────────────────────────────────────────────────────────────
model PaymentGroup {
  id               String   @id @default(cuid())
  orderNumber      String   @unique
  amountUsd        Float
  amountKhr        Float?
  paymentMethod    String
  paymentRef       String?
  paymentUrl       String?
  qrString         String?
  paymentExpiresAt DateTime?
  status           String   @default("PENDING")
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  paidAt           DateTime?

  @@index([status])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Game Items marketplace orders. Deliberately its own table, independent of
// the Top-up `Order`/`Product` model — a shopper can select several GameItem
// cards (optionally across different categories) and check out once; every
// selected line becomes a GameItemOrderItem under one GameItemOrder. Uses
// the same KHPay gateway as Top-up and Accounts via lib/payment.ts.
// ─────────────────────────────────────────────────────────────────────────
model GameItemOrder {
  id               String              @id @default(cuid())
  orderNumber      String              @unique
  buyerUsername    String
  // Optional Telegram/phone/email — no longer collected at checkout for
  // Game Items (a MANUAL order sends the buyer to admin's Telegram, with
  // order details pre-filled, right after payment). Left here in case it's
  // ever set some other way.
  customerContact  String?
  amountUsd        Float
  amountKhr        Float?
  currency         String              @default("USD")
  paymentMethod    String
  paymentRef       String?
  paymentUrl       String?
  qrString         String?
  paymentExpiresAt DateTime?
  // Snapshot of resolveDeliveryMode() across the order's line items at
  // checkout time, so it can't change retroactively if admin edits an
  // item later. "DIRECT" only when every line item is DIRECT.
  deliveryMode     String
  status           String              @default("PENDING")
  deliveryNote     String?
  failureReason    String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paidAt           DateTime?
  deliveredAt      DateTime?
  // Set when the buyer was signed in at checkout, so their order shows up
  // in the account History page. Null for guest checkouts — guest orders
  // stay lookup-only via the order number.
  userId           String?
  user             User?               @relation(fields: [userId], references: [id])
  items            GameItemOrderItem[]
  // Operator cost snapshot at purchase (profit dashboard). Null = unknown.
  costUsd          Float?
  costEstimated    Boolean             @default(false)
  // Set when this order was paid inside a combined multi-store checkout.
  paymentGroupId   String?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([paymentGroupId])
}

model GameItemOrderItem {
  id           String        @id @default(cuid())
  orderId      String
  gameItemId   String
  name         String
  quantity     Int           @default(1)
  unitPriceUsd Float
  createdAt    DateTime      @default(now())
  order        GameItemOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gameItem     GameItem      @relation(fields: [gameItemId], references: [id])

  @@index([orderId])
  @@index([gameItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// Accounts marketplace orders. Same pattern as GameItemOrder above, kept
// completely separate — its own table, never joined against GameItemOrder
// or the Top-up Order model, even though the storefront UI is designed to
// look identical.
// ─────────────────────────────────────────────────────────────────────────
model GameAccountOrder {
  id               String                 @id @default(cuid())
  orderNumber      String                 @unique
  customerContact  String?
  amountUsd        Float
  amountKhr        Float?
  currency         String                 @default("USD")
  paymentMethod    String
  paymentRef       String?
  paymentUrl       String?
  qrString         String?
  paymentExpiresAt DateTime?
  // Snapshot of resolveDeliveryMode() across the order's accounts' Game at
  // checkout time. "DIRECT" only when every account's game is DIRECT.
  deliveryMode     String
  status           String                 @default("PENDING")
  deliveryNote     String?
  failureReason    String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  paidAt           DateTime?
  deliveredAt      DateTime?
  // Set when the buyer was signed in at checkout, so their order shows up
  // in the account History page. Null for guest checkouts — guest orders
  // stay lookup-only via the order number.
  userId           String?
  user             User?                  @relation(fields: [userId], references: [id])
  items            GameAccountOrderItem[]
  // What the operator paid/how much the accounts cost (profit dashboard).
  // Accounts marketplace has no supplier — cost is admin-set per account.
  costUsd          Float?
  costEstimated    Boolean                @default(false)
  // Set when this order was paid inside a combined multi-store checkout.
  paymentGroupId   String?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([paymentGroupId])
}

model GameAccountOrderItem {
  id            String                 @id @default(cuid())
  orderId       String
  gameAccountId String
  title         String
  quantity      Int                    @default(1)
  unitPriceUsd  Float
  createdAt     DateTime               @default(now())
  order         GameAccountOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gameAccount   GameAccount            @relation(fields: [gameAccountId], references: [id])
  stockItems    GameAccountStockItem[]

  @@index([orderId])
  @@index([gameAccountId])
}

// Single-row table (id = 1) for the "welcome" popup shown to first-time
// visitors. Kept separate from Settings on purpose: adding columns to
// Settings would break every Settings query until `prisma db push` has run,
// whereas a new table only affects the popup itself.
model WelcomePopup {
  id          Int      @id @default(1)
  enabled     Boolean  @default(false)
  // Bumped from the admin ("show again to everyone") so returning visitors
  // who already dismissed an older popup see the new one.
  version     Int      @default(1)
  imageUrl    String?
  title       String   @default("")
  body        String?
  // One checklist item per line.
  bullets     String?
  telegramUrl String?
  buttonLabel String   @default("Join Telegram")
  closeLabel  String   @default("Close")
  updatedAt   DateTime @updatedAt
}

// The popup shown to a visitor who tries to top up / buy without being signed
// in (edited in Admin -> Sign-in Popup). One row, id = 1. When `enabled` is
// off — or the row doesn't exist yet — the popup falls back to a built-in
// default message, so the sign-in gate itself never depends on this table.
model SignInPopup {
  id         Int      @id @default(1)
  enabled    Boolean  @default(false)
  imageUrl   String?
  title      String   @default("")
  body       String?
  // One checklist item per line.
  bullets    String?
  closeLabel String   @default("Not now")
  updatedAt  DateTime @updatedAt
}
