generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  publisher      String?
  description    String?
  imageUrl       String
  bannerUrl      String?
  currencyName   String
  uidLabel       String        @default("Player ID")
  uidExample     String?
  requiresServer Boolean       @default(false)
  servers        String        @default("[]")
  featured       Boolean       @default(false)
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  GameAccount    GameAccount[]
  GameItem       GameItem[]
  orders         Order[]
  products       Product[]
}

model User {
  id           String         @id @default(cuid())
  email        String?        @unique
  phone        String?        @unique
  passwordHash String
  name         String?
  points       Int            @default(0)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  orders       Order[]
  pointsLedger PointsLedger[]
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  type      String
  points    Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
}

model Product {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  amount    Int
  bonus     Int      @default(0)
  priceUsd  Float
  priceKhr  Float?
  badge     String?
  imageUrl  String?
  active    Boolean  @default(true)
  stock     Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, active])
}

model Order {
  id                String     @id @default(cuid())
  orderNumber       String     @unique
  gameId            String
  productId         String
  playerUid         String
  serverId          String?
  playerNickname    String?
  customerEmail     String?
  customerPhone     String?
  amountUsd         Float
  amountKhr         Float?
  currency          String     @default("USD")
  paymentMethod     String
  paymentRef        String?
  paymentUrl        String?
  qrString          String?
  paymentExpiresAt  DateTime?
  status            String     @default("PENDING")
  deliveryNote      String?
  failureReason     String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  paidAt            DateTime?
  deliveredAt       DateTime?
  promoCodeId       String?
  discountUsd       Float      @default(0)
  pointsAwarded     Boolean    @default(false)
  pointsDiscountUsd Float      @default(0)
  pointsEarned      Int        @default(0)
  pointsRedeemed    Int        @default(0)
  stockDecremented  Boolean    @default(false)
  userId            String?
  game              Game       @relation(fields: [gameId], references: [id])
  product           Product    @relation(fields: [productId], references: [id])
  promoCode         PromoCode? @relation(fields: [promoCodeId], references: [id])
  user              User?      @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([userId])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Float
  minOrderUsd   Float     @default(0)
  maxUses       Int       @default(0)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("ADMIN")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model Settings {
  id                 Int      @id @default(1)
  siteName           String   @default("RITHTOPUP")
  exchangeRate       Float    @default(4100)
  supportTelegram    String?  @default("@rithtopup")
  supportEmail       String?  @default("support@rithtopup.com")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  announcement       String?
  announcementTone   String?  @default("info")
  telegramBotToken   String?
  telegramChatId     String?
  updatedAt          DateTime @updatedAt
  minRedeemPoints    Int      @default(100)
  pointsPerUsd       Float    @default(1)
  pointsRedeemRate   Float    @default(100)
}

model RobuxStock {
  id         Int      @id @default(1)
  totalRobux Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model HeroBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  ctaLabel  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverUrl    String?
  tag         String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model BlockedIdentity {
  id        String   @id @default(cuid())
  type      String
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model GameAccount {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  gameId      String?
  title       String
  rank        String?
  description String?
  imageUrl    String?
  priceUsd    Float
  priceKhr    Float?
  sold        Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  Game        Game?    @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([gameId])
}

model GameItem {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  gameId      String?
  name        String
  description String?
  imageUrl    String?
  priceUsd    Float
  priceKhr    Float?
  badge       String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  Game        Game?    @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([gameId])
}
