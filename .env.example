# PostgreSQL connection string
# Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL = the "Connection pooling" string (port 6543), with
#     ?pgbouncer=true appended — used for normal app queries.
#   DIRECT_URL   = the "Direct connection" string (port 5432) — used only
#     for `prisma db push` / migrations, since the pooler can't run those.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-xx.pooler.supabase.com:5432/postgres"

# JWT secret for admin auth (generate: openssl rand -base64 32)
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Admin bootstrap (used on first db:seed)
ADMIN_EMAIL="admin@sharustore.com"
ADMIN_PASSWORD="ChangeMeNow123!"

# Payment gateway credentials (leave blank to use simulation mode)
# KHPay — https://khpay.site/api-documentation
#   Generates KHQR codes scannable by ABA Pay, ACLEDA Pay, Wing,
#   TrueMoney, Chip Mong, Prince Bank and any other KHQR-compatible app.
KHPAY_BASE_URL="https://khpay.site/api/v1"
KHPAY_API_KEY=""
KHPAY_WEBHOOK_SECRET=""

# Base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Public URL for payment gateway callbacks (KHPay rejects localhost/private IPs).
# Local dev: use a tunnel → cloudflared tunnel --url http://localhost:3000
# Production: set to your real https domain.
PUBLIC_APP_URL=""

# Telegram customer sign-in. Nothing to set here — paste the bot token in
# Admin → Settings ("Telegram Notifications") and the login button turns on
# by itself (the bot's @username is looked up from the token). Optional
# override if you ever need to point the widget at a different bot:
# TELEGRAM_BOT_USERNAME="my_store_bot"

# Simulation mode: when "true", payments auto-complete after 3s (LOCAL DEV ONLY).
# Ignored automatically when NODE_ENV=production. Never enable on a live site.
PAYMENT_SIMULATION_MODE="false"

# Demo mode: when "true", the WHOLE buy flow is simulated for every product
# type — fake payment AND instant fake delivery (DEMO- gift codes, demo
# delivery notes instead of calling the supplier). Lets you walk cart → pay →
# order tracker → history → wallet without spending anything. Unlike
# PAYMENT_SIMULATION_MODE it works alongside a real KHPAY_API_KEY, but it is
# ALWAYS off when NODE_ENV=production. Local dev only.
#   "true"  = demo everything      "false"/unset = real flow
DEMO_MODE="true"

# Cloudinary - stores admin-uploaded images (games, banners, accounts, blog, products).
# Cloudinary dashboard -> Settings -> API Keys. NEVER share the API secret or commit your .env.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder inside your Cloudinary account (keeps this site's uploads apart from other projects).
CLOUDINARY_FOLDER="topupwebsite"

# FazerCards supplier (auto-delivery + Player ID check + price watcher).
# FazerCards is the only supplier in use.
# Put the key here yourself — never paste it in a chat.
FAZER_API_KEY=
# A pack is closed automatically when (your price - FazerCards cost) is below this (USD).
FAZER_MIN_PROFIT_USD=0.01
# Secret for the cron endpoints (/api/cron/*) — use at least 32 random characters.
# Call it every few minutes with the header:  Authorization: Bearer <this secret>
WATCHER_SECRET=