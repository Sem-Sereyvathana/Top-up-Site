# PostgreSQL connection string
# Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL = the "Connection pooling" string (port 6543), with
#     ?pgbouncer=true appended — used for normal app queries.
#   DIRECT_URL   = the "Direct connection" string (port 5432) — used only
#     for `prisma db push` / migrations, since the pooler can't run those.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-xx.pooler.supabase.com:5432/postgres"

# JWT secret for admin auth (generate: openssl rand -base64 32)
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# Admin bootstrap (used on first db:seed)
ADMIN_EMAIL="admin@rithtopup.com"
ADMIN_PASSWORD="ChangeMeNow123!"

# Payment gateway credentials (leave blank to use simulation mode)
# KHPay — https://khpay.site/api-documentation
#   Generates KHQR codes scannable by ABA Pay, ACLEDA Pay, Wing,
#   TrueMoney, Chip Mong, Prince Bank and any other KHQR-compatible app.
KHPAY_BASE_URL="https://khpay.site/api/v1"
KHPAY_API_KEY=""
KHPAY_WEBHOOK_SECRET=""

# Base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Public URL for payment gateway callbacks (KHPay rejects localhost/private IPs).
# Local dev: use a tunnel → cloudflared tunnel --url http://localhost:3000
# Production: set to your real https domain.
PUBLIC_APP_URL=""

# Simulation mode: when "true", payments auto-complete after 3s (for dev/demo)
PAYMENT_SIMULATION_MODE="true"

# Vercel Blob — stores admin-uploaded images (games, banners, accounts, blog,
# products). Required because Vercel's serverless functions can't write to
# local disk. Create one at: Vercel dashboard → your project → Storage →
# Create Database → Blob. It's auto-linked to your project and this value
# gets injected for you — locally, run `vercel env pull .env.local` to get it,
# or copy it from the dashboard by hand.
BLOB_READ_WRITE_TOKEN=""
